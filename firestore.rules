rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two of you can read or write memories — checked by email,
    // not just "any signed-in user", in case the project ever gets more accounts.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'thomas.jenkins1986@gmail.com',
          'hannah.isabella@googlemail.com'
        ];
    }

    match /memories/{memoryId} {
      allow read, write: if isAllowedUser();
    }
  }
}
